<?xml version='1.0' encoding='UTF-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SalesManagement_SysDev.StockView" Background="#F0F5F8" Foreground="#123D54" FontFamily="Yu Gothic UI" FontSize="14" Loaded="View_Loaded" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E4EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#526D7D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#123D54"/>
            <Setter Property="BorderBrush" Value="#CBDCE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#91B6C4"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#10858D"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="InputBorder" Property="Background" Value="#EDF3F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#123D54"/>
            <Setter Property="BorderBrush" Value="#CBDCE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="#10858D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBorder" Property="Background" Value="#EDF3F6"/>
                                <Setter TargetName="PasswordBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#123D54"/>
            <Setter Property="BorderBrush" Value="#CBDCE5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBDCE5"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Setter Property="Language" Value="ja-JP"/>
        </Style>
        <Style x:Key="EmployeeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10858D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#10858D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="HoverLayer" CornerRadius="6" Background="#123D54" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.09"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.19"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#123D54"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource EmployeeButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#087880"/>
            <Setter Property="BorderBrush" Value="#A8CDD2"/>
        </Style>
        <Style x:Key="ClearButtonStyle" TargetType="Button" BasedOn="{StaticResource EmployeeButtonStyle}">
            <Setter Property="Background" Value="#EFF3F6"/>
            <Setter Property="Foreground" Value="#526D7D"/>
            <Setter Property="BorderBrush" Value="#D7E1E7"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EDF5F8"/>
            <Setter Property="Foreground" Value="#426476"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="BorderBrush" Value="#D8E4EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#123D54"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D9ECEF"/>
                    <Setter Property="Foreground" Value="#123D54"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDF6F7"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D9ECEF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E7EEF2"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="mainPanel" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="在庫管理" FontSize="26" FontWeight="SemiBold"/>
                    <Button x:Name="btnOpenSearch" Content="検索画面へ →" Grid.Column="1" Style="{StaticResource EmployeeButtonStyle}" Click="OpenSearch_Click"/>
                </Grid>
                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="txtMode" FontWeight="SemiBold" FontSize="16" Foreground="#10858D" Margin="0,0,0,12"/>
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,14,12">
                                <TextBlock Text="在庫ID" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtStockId" MaxLength="10" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12">
                                <TextBlock Text="商品ID" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtProductId" MaxLength="10" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12">
                                <TextBlock Text="商品名" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtProductName" MaxLength="50" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12">
                                <TextBlock Text="安全在庫数" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtSafety" MaxLength="10" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12">
                                <TextBlock Text="現在の在庫数" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtCurrentQuantity" MaxLength="11" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,12">
                                <TextBlock Text="更新後の在庫数" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtQuantity" MaxLength="10"/>
                            </StackPanel>
                        </UniformGrid>
                        <WrapPanel>
                            <Button x:Name="btnUpdate" Content="更新" Style="{StaticResource EmployeeButtonStyle}" Margin="0,0,10,6" Click="Update_Click"/>
                            <Button x:Name="btnHide" Content="非表示" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,6" Click="Hide_Click"/>
                            <Button x:Name="btnClear" Content="クリア" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,6" Click="Clear_Click"/>
                            <Button x:Name="btnList" Content="一覧表示" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,6" Click="List_Click"/>
                            <Button x:Name="btnConfirm" Content="確定" Style="{StaticResource EmployeeButtonStyle}" Margin="0,0,10,6" Click="Confirm_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="txtPending" Foreground="#087880" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock Text="在庫数は更新後の数量を入力してください。非表示は在庫数を変更しません。" Foreground="#718894" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="在庫一覧" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Items.Count, ElementName=gridStocks, StringFormat='表示件数：{0}件'}" Foreground="#718894"/>
                </Grid>
                <DataGrid x:Name="gridStocks" Grid.Row="1" MinHeight="90" Margin="1,0,1,8" SelectionChanged="Stocks_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="在庫ID" Binding="{Binding Id}" Width="85"/>
                        <DataGridTextColumn Header="商品ID" Binding="{Binding ProductId}" Width="85"/>
                        <DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="*" MinWidth="180"/>
                        <DataGridTextColumn Header="在庫数" Binding="{Binding Quantity}" Width="110"/>
                        <DataGridTextColumn Header="安全在庫数" Binding="{Binding SafetyStock}" Width="110"/>
                        <DataGridTextColumn Header="在庫状態" Binding="{Binding StockState}" Width="145"/>
                        <DataGridTextColumn Header="商品表示" Binding="{Binding ProductState}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#E8F0F4" CornerRadius="6" Padding="12,9" Margin="0,12,0,0">
            <TextBlock x:Name="txtMessage" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
