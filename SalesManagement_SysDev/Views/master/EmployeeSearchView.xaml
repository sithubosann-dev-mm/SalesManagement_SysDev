<UserControl x:Class="SalesManagement_SysDev.EmployeeSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F5F8" Foreground="#123D54"
             FontFamily="Yu Gothic UI" FontSize="14"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             Loaded="View_Loaded">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E4EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#526D7D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#123D54"/>
            <Setter Property="BorderBrush" Value="#CBDCE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#91B6C4"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#10858D"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="InputBorder" Property="Background" Value="#EDF3F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#123D54"/>
            <Setter Property="BorderBrush" Value="#CBDCE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBorder" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="#10858D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBorder" Property="Background" Value="#EDF3F6"/>
                                <Setter TargetName="PasswordBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#123D54"/>
            <Setter Property="BorderBrush" Value="#CBDCE5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBDCE5"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Setter Property="Language" Value="ja-JP"/>
        </Style>
        <Style x:Key="EmployeeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10858D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#10858D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="HoverLayer" CornerRadius="6" Background="#123D54"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.09"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.19"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#123D54"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource EmployeeButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#087880"/>
            <Setter Property="BorderBrush" Value="#A8CDD2"/>
        </Style>
        <Style x:Key="RegisterButtonStyle" TargetType="Button" BasedOn="{StaticResource EmployeeButtonStyle}">
            <Setter Property="IsEnabled" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=gridEmployees}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UpdateButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=gridEmployees}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HideButtonStyle" TargetType="Button" BasedOn="{StaticResource UpdateButtonStyle}">
            <Setter Property="Background" Value="#FFF8F8"/>
            <Setter Property="Foreground" Value="#B54D56"/>
            <Setter Property="BorderBrush" Value="#E5BDC2"/>
        </Style>
        <Style x:Key="ClearButtonStyle" TargetType="Button" BasedOn="{StaticResource EmployeeButtonStyle}">
            <Setter Property="Background" Value="#EFF3F6"/>
            <Setter Property="Foreground" Value="#526D7D"/>
            <Setter Property="BorderBrush" Value="#D7E1E7"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EDF5F8"/>
            <Setter Property="Foreground" Value="#426476"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="BorderBrush" Value="#D8E4EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#123D54"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D9ECEF"/>
                    <Setter Property="Foreground" Value="#123D54"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDF6F7"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D9ECEF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" MaxHeight="410" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
            <StackPanel x:Name="searchPanel">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="社員検索" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="← 社員管理へ"
                            Style="{StaticResource EmployeeButtonStyle}" Click="Back_Click"/>
                </Grid>
                <Border Style="{StaticResource CardStyle}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="検索条件" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <StackPanel Width="150" Margin="0,0,14,8">
                                <TextBlock Text="社員ID（前方一致）" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtSearchId" AutomationProperties.Name="検索 社員ID"/>
                            </StackPanel>
                            <StackPanel Width="240" Margin="0,0,14,8">
                                <TextBlock Text="社員名（部分一致）" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="txtSearchName" MaxLength="50" AutomationProperties.Name="検索 社員名"/>
                            </StackPanel>
                            <StackPanel Width="210" Margin="0,0,14,8">
                                <TextBlock Text="営業所" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="cmbSearchOffice" DisplayMemberPath="SoName" SelectedValuePath="SoId"
                                          AutomationProperties.Name="検索 営業所"/>
                            </StackPanel>
                            <StackPanel Width="170" Margin="0,0,14,8">
                                <TextBlock Text="役職" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="cmbSearchPosition" DisplayMemberPath="PoName" SelectedValuePath="PoId"
                                          AutomationProperties.Name="検索 役職"/>
                            </StackPanel>
                            <Button Content="検索" VerticalAlignment="Bottom" Style="{StaticResource EmployeeButtonStyle}"
                                    Click="Search_Click" Margin="0,0,10,8"/>
                            <Button Content="一覧表示" VerticalAlignment="Bottom" Style="{StaticResource OutlineButtonStyle}"
                                    Click="List_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <!-- <TextBlock Text="入力した条件をすべて満たす社員を検索します。空欄・未選択の項目は条件に含めません。一覧表示で検索条件をリセットします。"
                                   Foreground="#718894" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/> -->
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="検索結果" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="#718894" VerticalAlignment="Center" Margin="0,0,14,0"
                                   Text="{Binding Items.Count, ElementName=gridEmployees, StringFormat='表示件数：{0}件'}"/>
                        <Button x:Name="btnEdit" Content="選択した社員を編集"
                                Style="{StaticResource EmployeeButtonStyle}" Click="Edit_Click"/>
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="gridEmployees" Grid.Row="1" MinHeight="60" Margin="1,0,1,8"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="True"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          MouseDoubleClick="Employees_MouseDoubleClick"
                          
                          BorderThickness="0" Background="White" RowBackground="White"
                          AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E7EEF2" EnableRowVirtualization="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="社員ID" Binding="{Binding Id}" Width="90"/>
                        <DataGridTextColumn Header="社員名" Binding="{Binding Name}" Width="*" MinWidth="130"/>
                        <DataGridTextColumn Header="営業所" Binding="{Binding Office}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="役職" Binding="{Binding Position}" Width="120"/>
                        <DataGridTextColumn Header="入社日" Binding="{Binding HireDate, StringFormat={}{0:yyyy/MM/dd}}" Width="130"/>
                        <DataGridTextColumn Header="電話番号" Binding="{Binding Phone}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="1" Text="表示する社員がいません。検索条件を確認してください。"
                           Foreground="#718894" FontSize="13" TextWrapping="Wrap" Margin="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=gridEmployees}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#E8F0F4" CornerRadius="6" Padding="12,9" Margin="0,12,0,0">
            <TextBlock x:Name="txtMessage" Foreground="#123D54" FontSize="12" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
