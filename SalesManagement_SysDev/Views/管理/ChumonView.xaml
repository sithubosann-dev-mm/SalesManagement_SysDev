<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SalesManagement_SysDev.ChumonView" Background="#F0F5F8" Foreground="#123D54" FontFamily="Yu Gothic UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" Loaded="View_Loaded">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E4EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#526D7D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#123D54"/>
            <Setter Property="BorderBrush" Value="#CBDCE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#91B6C4"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#10858D"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="InputBorder" Property="Background" Value="#EDF3F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#123D54"/>
            <Setter Property="BorderBrush" Value="#CBDCE5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBDCE5"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Setter Property="Language" Value="ja-JP"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#10858D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#10858D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="HoverLayer" CornerRadius="6" Background="#123D54" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.09"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.19"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#123D54"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#087880"/>
            <Setter Property="BorderBrush" Value="#A8CDD2"/>
        </Style>
        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Secondary}">
            <Setter Property="Background" Value="#FFF8F8"/>
            <Setter Property="Foreground" Value="#B54D56"/>
            <Setter Property="BorderBrush" Value="#E5BDC2"/>
        </Style>
        <Style x:Key="Clear" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#EFF3F6"/>
            <Setter Property="Foreground" Value="#526D7D"/>
            <Setter Property="BorderBrush" Value="#D7E1E7"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EDF5F8"/>
            <Setter Property="Foreground" Value="#426476"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="BorderBrush" Value="#D8E4EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#123D54"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D9ECEF"/>
                    <Setter Property="Foreground" Value="#123D54"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDF6F7"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D9ECEF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E7EEF2"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24" x:Name="mainPanel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12" x:Name="headerPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="注文管理" FontSize="26" FontWeight="SemiBold" x:Name="txtHeading"/>
            <TextBlock Text="注文を選択して商品明細を確認できます。" Foreground="#718894" Margin="0,4,0,0" TextWrapping="Wrap" x:Name="txtPageTitle" Visibility="Collapsed"/>
            <WrapPanel Margin="0" Grid.Column="1" VerticalAlignment="Center">
                <Button Content="検索画面へ →" Style="{StaticResource Action}" Click="ShowSearch_Click"/>
            </WrapPanel>
        </Grid>
        <Grid x:Name="tabs" Grid.Row="1">
            <Grid Margin="0" x:Name="pageList">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12" Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="注文一覧" FontSize="16" FontWeight="SemiBold" Margin="18,14"/>
                        <DataGrid x:Name="gridChumons" MinHeight="80" SelectionChanged="Chumons_SelectionChanged" Grid.Row="1" Margin="1,0,1,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="注文ID" Binding="{Binding Id}" Width="80"/>
                                <DataGridTextColumn Header="受注ID" Binding="{Binding OrderId}" Width="80"/>
                                <DataGridTextColumn Header="注文日" Binding="{Binding Date, StringFormat=yyyy/MM/dd, TargetNullValue=未設定}" Width="110"/>
                                <DataGridTextColumn Header="顧客" Binding="{Binding Client}" Width="*"/>
                                <DataGridTextColumn Header="営業所" Binding="{Binding Office}" Width="130"/>
                                <DataGridTextColumn Header="状態" Binding="{Binding State}" Width="90"/>
                                <DataGridTextColumn Header="合計" Binding="{Binding Total, StringFormat=N0, TargetNullValue=—}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Margin="0,10,0,6">
                    <TextBlock x:Name="txtSelected" Text="注文を選択すると、ここに選択内容を表示します。" TextWrapping="Wrap" Foreground="#087880"/>
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12" Grid.Row="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="商品明細" FontSize="16" FontWeight="SemiBold" Margin="18,14"/>
                        <DataGrid x:Name="gridDetails" MinHeight="110" Grid.Row="1" Margin="1,0,1,8" FontSize="15">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="商品ID" Binding="{Binding ProductId}" Width="90"/>
                                <DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="100"/>
                                <DataGridTextColumn Header="金額" Binding="{Binding Total, StringFormat=N0, TargetNullValue=—}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="非表示" Style="{StaticResource Danger}" Margin="0,0,10,6" IsEnabled="False" ToolTip="この処理は準備中です。今回の接続範囲は注文の表示・検索です。" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="btnConfirm" Content="注文確定 → 出庫管理" Click="Confirm_Click" Style="{StaticResource Action}" Margin="0,0,10,6" IsEnabled="False"/>
                    </WrapPanel>
                    <TextBlock Text="合計：—" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" x:Name="txtDetailTotal" Grid.Column="1"/>
                </Grid>
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="一覧表示" Click="List_Click" Style="{StaticResource Secondary}" Margin="0,0,10,6"/>
                </WrapPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#E8F0F4" CornerRadius="5" Padding="12,8" Margin="0,12,0,0">
            <TextBlock x:Name="txtMessage" TextWrapping="Wrap" Text="注文情報を読み込みます。"/>
        </Border>
    </Grid>
</UserControl>
