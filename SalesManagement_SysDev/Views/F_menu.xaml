<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Icon="/Images/MY21.ico"
        x:Class="SalesManagement_SysDev.F_menu" Title="販売在庫管理システム・メニュー" 
        WindowState="Maximized" WindowStartupLocation="CenterScreen" 
        Background="#F0F5F8" FontFamily="Yu Gothic UI" UseLayoutRounding="True">
    <Window.Resources>
        <!-- 共通きれいなやつ -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10858D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#096C73"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#07555B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ホームとログアウト -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <!-- カード -->
        <Style x:Key="MenuButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#123D54"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="#CFDDEA" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#E0F2F3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#C9E7E9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- sidebar管理メニュー -->
        <Style x:Key="SidebarMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- hectar-->
        <Border Background="#123D54" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnHamburger" Content="☰" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,16,0" Style="{StaticResource ActionButtonStyle}" Click="btnHamburger_Click" Grid.Column="0"/>
                <Button x:Name="btnTopLogout" Content="ログアウト" VerticalAlignment="Center" Margin="0" Style="{StaticResource ActionButtonStyle}" Click="btnLogout_Click" Grid.Column="3"/>
                <TextBlock x:Name="txtTitle" Text="販売在庫管理システム" Foreground="White" FontSize="20" VerticalAlignment="Center" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                <TextBlock Foreground="#EAF7F8" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,0" ToolTip="このパソコンの現在日時" x:Name="txtCurrentDateTime" Grid.Column="2"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 白いsidebar -->
            <Border x:Name="sidebar" Width="300" Visibility="Collapsed" Background="White" BorderBrush="#CFDDEA" BorderThickness="0,0,1,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- profile管理メニュー -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <StackPanel>
                            <Border Background="#F0F5F8" BorderBrush="#CFDDEA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,20">
                                <StackPanel>
                                    <TextBlock Text="ユーザープロフィール" Foreground="#00858F" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                    <TextBlock x:Name="txtProfileName" Foreground="#123D54" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="txtProfileId" Foreground="#536B80" FontSize="13" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtProfileRole" Foreground="#536B80" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtProfileOffice" Foreground="#536B80" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="panelNavigation"/>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- ホームとログアウト -->
                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <Button Content="ホーム" Style="{StaticResource SidebarButtonStyle}" Click="btnHome_Click"/>
                        <Button Content="ログアウト" Style="{StaticResource SidebarButtonStyle}" Click="btnLogout_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <!-- ホーム見せる -->
                <ScrollViewer x:Name="homeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="36">
                        <TextBlock Text="メインメニュー" Foreground="#123D54" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtEmployeeInfo" Foreground="#536B80" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,6"/>
                        <TextBlock x:Name="txtOffice" Foreground="#536B80" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,28"/>
                        <TextBlock Text="マスタ管理" Foreground="#00858F" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <WrapPanel x:Name="panelMaster"/>
                        <TextBlock Text="業務管理" Foreground="#00858F" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,14"/>
                        <WrapPanel x:Name="panelBusiness"/>
                    </StackPanel>
                </ScrollViewer>
                <!-- 各管理画面 -->
                <ContentControl x:Name="screenHost" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>