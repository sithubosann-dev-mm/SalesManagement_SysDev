<Window x:Class="SalesManagement_SysDev.F_login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="販売在庫管理システム・ログイン"
        Icon="/Images/MY21.ico"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Yu Gothic UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10858D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#096C73"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#07555B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#CBD9E6" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#123D54">
                <TextBlock Text="販売在庫管理システム・ログイン"
                           Foreground="White" FontSize="14"
                           Margin="18,0" VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Row="1" Width="440" Padding="28"
                    Background="#F0F5F8" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="ログイン"
                               Foreground="#00858F" FontSize="16"
                               FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Border Background="White" BorderBrush="#CFDDEA"
                            BorderThickness="1" CornerRadius="5"
                            Padding="10,7" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="社員ID"
                                       Foreground="#6D819C" FontSize="11"/>
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="53*"/>
                                    <ColumnDefinition Width="128*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtEmployeeId"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#243B53" FontSize="14" Padding="0" Grid.ColumnSpan="2"/>

                                <TextBlock Text="入力してください"
                                           Foreground="#6D819C" FontSize="14"
                                           IsHitTestVisible="False" Grid.ColumnSpan="2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtEmployeeId}"
                                                             Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#CFDDEA"
                            BorderThickness="1" CornerRadius="5"
                            Padding="10,7" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="パスワード"
                                       Foreground="#6D819C" FontSize="11"/>
                            <PasswordBox x:Name="pwdPassword" 
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#243B53" FontSize="14"
                                         Padding="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnLogin" Content="ログイン"
                                Style="{StaticResource ActionButtonStyle}"
                                IsDefault="True" Click="btnLogin_Click"/>

                        <Button x:Name="btnPasswordChange" Content="パスワード変更"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="10,0,0,0" Click="btnPasswordChange_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="txtMessage"
                               Foreground="#D64545" FontSize="12"
                               TextWrapping="Wrap" Margin="0,14,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>