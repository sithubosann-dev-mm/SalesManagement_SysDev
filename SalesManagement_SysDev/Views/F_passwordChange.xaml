<Window x:Class="SalesManagement_SysDev.F_passwordChange"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="販売在庫管理システム・パスワード変更"
        Width="550" Height="550"
        Icon="/Images/MY21.ico"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F0F5F8"
        
        FontFamily="Yu Gothic UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CFDDEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CFDDEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <StackPanel>
            <TextBlock Text="パスワード変更"
                       Foreground="#00858F" FontSize="20"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>

            <TextBlock Text="現在のパスワードを確認してから変更します。"
                       Foreground="#6D819C" FontSize="12" Margin="0,0,0,18"/>

            <TextBlock Text="社員ID"/>
            <TextBox x:Name="txtEmployeeId"/>

            <TextBlock Text="現在のパスワード"/>
            <PasswordBox x:Name="pwdCurrent"/>

            <TextBlock Text="新しいパスワード（1～10文字）"/>
            <PasswordBox x:Name="pwdNew" MaxLength="10"/>

            <TextBlock Text="新しいパスワード（確認）"/>
            <PasswordBox x:Name="pwdConfirm" MaxLength="10"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnSave" Content="変更する"
                        Background="#10858D" Foreground="White"
                        BorderThickness="0" IsDefault="True"
                        Click="btnSave_Click"/>

                <Button x:Name="btnCancel" Content="キャンセル"
                        Margin="10,0,0,0" Click="btnCancel_Click"/>
            </StackPanel>

            <TextBlock x:Name="txtError"
                       Foreground="#D64545" FontSize="12"
                       TextWrapping="Wrap" Margin="0,14,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>